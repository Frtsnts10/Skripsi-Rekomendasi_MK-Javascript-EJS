          <label for="NIM">NIM</label>
          <input type="text" class="form-control" id="NIM" name="NIM" placeholder="Enter NIM" required />
        </div>

        <% for (var a=0;a<9;a++){ %>
          <% var nama_MK = "nama_MK" + a; %>
          <% var nilai = "nilai" + a; %>
          <% var hasil = "hasil" + a; %>
          <div class="form-group" style="border-top: 1px solid var(--border); padding-top: var(--space-3);">
            <label for="<%=nama_MK%>">Mata Kuliah <%= a + 1 %></label>
            <input type="text" class="form-control" id="<%=nama_MK%>" name="<%=nama_MK%>" placeholder="Nama mata kuliah" required style="margin-bottom: var(--space-2);" />
            <input type="text" class="form-control" id="<%=nilai%>" name="<%=nilai%>" placeholder="Nilai" required style="margin-bottom: var(--space-2);" />
            <input type="text" class="form-control" id="<%=hasil%>" name="<%=hasil%>" placeholder="Hasil" required />
          </div>
          <%}%>

        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
          <button type="submit" class="btn btn-primary">Input</button>
        </div>
      </form>
    </div>
  </div>
</div>
