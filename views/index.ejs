<!DOCTYPE html>
<html lang="id">
  <head>
    <title>Aplikasi Prediksi dan Rekomendasi Nilai Mahasiswa</title>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/app.css">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
  </head>

  <body class="page">
    <header class="topbar">
      <img class="brand-logo" src="Logo.jpg" alt="Logo">
      <h2 class="brand-title mb-0">Daftar Nilai Mahasiswa</h2>
      <div class="topbar-spacer"></div>
      <a class="btn btn-secondary btn-sm" href="IndexAdmin">&larr; Kembali</a>
    </header>

    <main class="page-body">
      <% if (typeof alert !== 'undefined' && alert.message && alert.message.length) { %>
        <div class="alert alert-<%= alert.status[0] === 'success' ? 'success' : 'danger' %>"><%= alert.message[0] %></div>
      <% } %>

      <%- include('table.ejs') %>
      <%- include('modal.ejs') %>
    </main>

    <script>
      $("#dataTable").on("click", ".button-update", function () {
        let id = $(this).data("id");
        let Nama = $(this).data("nama");
        let NIM = $(this).data("nim");
        let matkul = $(this).data("matkul");

        $("#edit_id").val(id);
        $("#edit_Nama").val(Nama);
        $("#edit_NIM").val(NIM);

        for (let i = 0; i < matkul.length; i++) {
          $("#edit_nama_MK" + i).val(matkul[i].nama_MK);
          $("#edit_nilai" + i).val(matkul[i].nilai);
          $("#edit_hasil" + i).val(matkul[i].hasil);
        }

        $("#edit_modal").modal("show");
      });
    </script>
  </body>
</html>
