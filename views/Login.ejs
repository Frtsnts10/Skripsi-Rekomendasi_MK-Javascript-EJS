<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/app.css">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Login | Aplikasi Prediksi dan Rekomendasi Matakuliah</title>
</head>

<body class="page">
    <main class="page-body page-body--narrow center">
        <img class="brand-logo" src="Logo.jpg" alt="Logo" style="width: 72px; height: 72px; object-fit: contain; margin-bottom: var(--space-3);">
        <h1 style="font-size: 20px;">Aplikasi Prediksi dan Rekomendasi Nilai Mahasiswa</h1>

        <% if (typeof error !== 'undefined' && error && error.length) { %>
          <div class="alert alert-danger"><%= error[0] %></div>
        <% } %>

        <div class="card mt-4">
            <form action="/Login" method="post">
                <div class="form-group">
                    <label for="username">Nama User</label>
                    <input id="username" name="username" type="text" placeholder="Nama User" class="form-control" required>
                </div>
                <div class="form-group mb-0">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password" placeholder="Password" class="form-control" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block mt-4">Login</button>
            </form>
        </div>

        <p>Belum punya akun? <a href="/Register">Daftar baru</a></p>
        <p><a href="/Home">&larr; Kembali ke beranda</a></p>
    </main>
</body>
</html>
