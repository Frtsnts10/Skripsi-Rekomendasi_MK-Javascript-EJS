<!DOCTYPE html>
<html lang="id">
<head>
    <title>Aplikasi Prediksi dan Rekomendasi Nilai Mahasiswa</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/app.css">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="page">
  <header class="topbar">
    <img class="brand-logo" src="Logo.jpg" alt="Logo">
    <h2 class="brand-title mb-0">Nilai Saya</h2>
    <div class="topbar-spacer"></div>
    <a class="btn btn-secondary btn-sm" href="IndexMhs">&larr; Kembali</a>
  </header>

  <main class="page-body page-body--narrow">
    <h3>Nama Mahasiswa: <span id="unamemhs"><%= currentUser.username %></span></h3>
    <% for(var a=0; a < datalist.length;a++) { %>
      <% if(datalist[a].Nama == currentUser.username){ %>
        <h3>NIM Mahasiswa: <%= datalist[a].NIM %></h3>
      <% } %>
    <% } %>

    <div class="table-wrap mt-4">
      <table>
        <thead>
          <tr>
            <th>Matakuliah</th>
            <th>Nilai</th>
          </tr>
        </thead>
        <tbody>
          <% var Total = 0; %>
          <% for(var a=0; a < datalist.length; a++) { %>
            <% for(var b=0; b < datalist[a].matkul.length; b++) { %>
              <% if(datalist[a].Nama == currentUser.username){ %>
                <% Total = Total + parseInt(datalist[a].matkul[b].nilai) %>
                <tr>
                  <td><%= datalist[a].matkul[b].nama_MK %></td>
                  <td><%= datalist[a].matkul[b].nilai %></td>
                </tr>
              <% } %>
            <% } %>
          <% } %>
        </tbody>
      </table>
    </div>

    <p class="center mt-4">
      <strong>Rata-Rata Nilai: <%= Math.ceil(Total / datalist[0].matkul.length) %></strong>
    </p>
  </main>
</body>
</html>
