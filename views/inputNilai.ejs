<!DOCTYPE html>
<html lang="id">
<head>
    <title>Aplikasi Prediksi dan Rekomendasi Nilai Mahasiswa</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/app.css">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>
</head>

<body class="page">
    <header class="topbar">
        <img class="brand-logo" src="Logo.jpg" alt="Logo">
        <h2 class="brand-title mb-0">Input Nilai Mahasiswa</h2>
        <div class="topbar-spacer"></div>
        <a class="btn btn-secondary btn-sm" href="IndexAdmin">&larr; Kembali</a>
    </header>

    <main class="page-body page-body--narrow">
        <div class="card">
            <form action="/datamatakuliah" method="POST">
                <div class="form-group">
                    <label for="Nama">Nama</label>
                    <input type="text" class="form-control" id="Nama" name="Nama" placeholder="Enter Nama" required/>
                </div>
                <div class="form-group mb-0">
                    <label for="NIM">NIM</label>
                    <input type="text" class="form-control" id="NIM" name="NIM" placeholder="Enter NIM" required/>
                </div>
            </form>
        </div>
    </main>

    <footer class="site-footer">
        <p class="mb-0">Created by Filbert</p>
    </footer>
</body>
</html>
