<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/app.css">
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <title>
      Cek Rekomendasi | Aplikasi Prediksi Nilai dan Rekomendasi MataKuliah
    </title>
  </head>

  <body class="page">
    <header class="topbar">
      <img class="brand-logo" src="Logo.jpg" alt="Logo">
      <h2 class="brand-title mb-0">Cek Rekomendasi Matakuliah</h2>
      <div class="topbar-spacer"></div>
      <a class="btn btn-secondary btn-sm" href="IndexMhs">&larr; Kembali</a>
    </header>

    <main class="page-body page-body--narrow">
      <div class="card">
        <div class="form-group mb-0">
          <label for="pilihan1">Pilihan Matakuliah yang ingin diambil</label>
          <select name="" id="pilihan1" class="form-control" onchange="handleSelectChange(event)">
            <option value="">Pilih Kelompok</option>
            <option value="Data Science">Data Science</option>
            <option value="Intelligence Systems">Intelligence Systems</option>
            <option value="Game Development">Game Development</option>
            <option value="Advance Programming">Advanced Programming</option>
          </select>
        </div>

        <button class="btn btn-primary btn-block mt-4" onclick="window.location='/HasilRek'">
          Cek Hasil Rekomendasi
        </button>
      </div>
    </main>

    <span id="usr" hidden><%= JSON.stringify(datalist) %></span>

    <script>
      var usr = JSON.parse($('#usr').text());
      $('#usr').remove();
      console.log(usr)

      function handleSelectChange(event) {
        var selectElement = event.target;
        var value = selectElement.value;
        if(value=="Data Science"){
          var index="Data Science";
        } else if(value=="Intelligence Systems"){
          var index="Intelligence Systems";
        } else if(value=="Game Development"){
          var index="Game Development";
        } else{
          var index="Advanced Programming";
        }

        window.localStorage.setItem("KelompokMK", index);
        console.log(index);
      }
    </script>

    <script>
      var MK1 = window.localStorage.getItem("ANN");
      var HMk1 = window.localStorage.getItem("HMk1");

      var MK2 = window.localStorage.getItem("ML");
      var HMk2 = window.localStorage.getItem("HMk2");

      var MK3 = window.localStorage.getItem("COMVIS");
      var HMk3 = window.localStorage.getItem("HMk3");

      var MK4 = window.localStorage.getItem("DM");
      var HMk4 = window.localStorage.getItem("HMk4");

      var MK5 = window.localStorage.getItem("NLP");
      var HMk5 = window.localStorage.getItem("HMk5");
    </script>
  </body>
</html>
